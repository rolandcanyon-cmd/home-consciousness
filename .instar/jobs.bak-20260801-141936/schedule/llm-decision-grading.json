{
  "slug": "llm-decision-grading",
  "origin": "instar",
  "schedule": "0 * * * *",
  "priority": "low",
  "expectedDurationMinutes": 2,
  "enabled": false,
  "execute": {
    "type": "agentmd"
  },
  "manifestVersion": 1,
  "model": "haiku",
