# Runtime state — never commit these
.instar/state/
.instar/logs/
.instar/audit/
.instar/*.tmp
.instar/server-data/
.instar/imessage/
.instar/ledger/
.instar/bin/
.instar/views/
.instar/paste/
.instar/backups/
.instar/machine/
.instar/shadow-install/
.instar/secrets/
.instar/jobs/
.instar/jobs.json.pre-migrate-*
.instar/keys/
.instar/.backup-worktree/

# SQLite databases and WAL files
.instar/*.db
.instar/*.db-shm
.instar/*.db-wal
.instar/memory.db
.instar/memory.db-*

# Runtime JSON files updated by the server
.instar/feedback.json
.instar/security.jsonl
.instar/degradations.json
.instar/skill-telemetry.jsonl
.instar/imessage-messages.jsonl
.instar/imessage-poll-offset.json
.instar/machine-health/
.instar/projects-digest.cache

# Secrets and per-machine config
.instar/config.json
.instar/context/project.dc
.instar/secrets/pr-gate/

# Machine-specific / instance-specific files
# Use setup/bootstrap.sh to regenerate for each install
.instar/AGENT.md
.instar/MEMORY.md
.claude/settings.json
.claude/settings.json.bak*
.claude/settings.local.json
.mcp.json

# Tokens and auth
.kittenkong-token.json

# Claude Code
.claude/projects/
.claude/todos/
.claude/scripts/__pycache__/
.claude/scripts/.instar/

# Playwright browser sessions
.playwright-mcp/

# Dependencies
node_modules/

# Logs
logs/

# Screenshots and test artifacts
*.png
*.jpg
test_funkygibbon.db

# Accidental files
*T*:*:*.???Z
.instar/cartographer/
the-goodies-python/

# Live identity files — contain PII and house-specific data, not for public repos
# Templates live in setup/*.md.template
.claude/identity/USER.md
.claude/identity/MEMORY.md
.claude/identity/AGENT.md

# Runtime state at root level
state/

# Runtime instar state files that slip through
.instar/quota-state.json
.instar/lease-local.json
.instar/local/
.instar/semantic-snapshot.json
.instar/semantic.jsonl
.instar/stuck-input-events.jsonl
.instar/episodes/

# Runtime job state files
commitment-detection-bookmark.json
*-bookmark.json
.instar/local/server-instance.lock
.instar/local/*.lock
.instar/state/*.lock

# Judgment-call provenance rows (machine-local decision context — never commit)
state/judgment-provenance/
